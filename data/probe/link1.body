    height: 100%;
    width: 100%;
}
div.dxcvAGLECW > div,
div.dxcvFLECW > div
{
    display: table-cell;
    vertical-align: middle;
}
div.dxcvEMBC > div[id$='DXEPLPC']
{
    height: auto;
}

/* Breakpoints layout */
.dxbplc {
	display: inline-block;
	vertical-align: bottom;
	width: 0;
}

/* ASPxGridView */
.dxgv a:-moz-any-link:focus {
    outline: 1px dotted;
}

.dxgv *[class^="col-xs-"], /*Bootstrap correction*/
.dxgv *[class^="col-sm-"],
