{
    padding: 1px;
}
.dxucControl_MaterialCompact .dxucInputs_MaterialCompact
{
    border-collapse: separate;
    border-width: 0;
}
.dxucTextBox_MaterialCompact
{
    background-color: white;
    border: 1px solid #DFDFDF;
    padding: 1px 8px;
}
