.dxflLTR .dxflNoDefaultPaddings > tbody > tr > .dxflFirstChildInRowSys > .dxflItemSys.dxflItemWithEdgeHelpTextSys > tbody > tr > td > table > tbody > tr > .dxflLHelpTextSys,
