/* Out of range warning*/
.dxeOutOfRWarn_MaterialCompact
{
    font: 14px 'Roboto Regular', Helvetica, 'Droid Sans', Tahoma, Geneva, sans-serif;
    padding: 3px 8px 4px 8px;
    display: none;
    position: absolute;
    background-color: white;
    color: red;
    -webkit-border-radius: 3px;
