/* Color edit */
.dxcpColorAreaSys {
	background-image: url('/Nutrition/DXR.axd?r=1_174-9S3tn');
	position: relative;
	width: 290px;
	height: 240px;
	overflow: hidden;
	cursor: crosshair;
}
.dxcpHueAreaSys {
	position: relative;
	margin-left: 3px;
	width: 35px;
	height: 242px;
}
.dxcpHueAreaImageSys {
	background-image: url('/Nutrition/DXR.axd?r=1_176-9S3tn');
	position: absolute;
	left: 6px;
	width: 21px;
    height: 240px;
}
.dxcpColorAreaSys,
.dxcpHueAreaSys {
	-webkit-touch-callout: none;
	-webkit-user-select: none;
	-khtml-user-select: none;
	-ms-user-select: none;
	user-select: none;
}
.dxcpColorPointerSys {
	background-image: url('/Nutrition/DXR.axd?r=1_175-9S3tn');
	position: absolute;
	width: 11px;
	height: 11px;
}
