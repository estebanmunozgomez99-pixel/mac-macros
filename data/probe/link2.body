 });
 var LensControl = ASPx.CreateClass(ASPxClientImageControlBase, {
  constructor: function(zoomWindow) {
   this.zoomWindow = zoomWindow;
   this.mainElement = null;
   this.panels = null;
   this.topPanel = null;
