 var DesktopAction = ASPx.CreateClass(ASPxClientImageControlBase, {
  constructor: function(imageZoom) {
   this.imageZoom = imageZoom;
   this.zoomWindowLockCount = 0;
   this.mouseX = 0;
   this.mouseY = 0;
   this.zoomOffsetX = 0;
   this.zoomOffsetY = 0;
