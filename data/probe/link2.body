  if(!item.texts)
   return item.texts;
  var adjustedItemTexts = [];
  for(var i = 0; i < item.texts.length; i++) {
   var itemText = item.texts[i] || "";
   if(!this.listBox.encodeHtml && !preventEncodeText)
