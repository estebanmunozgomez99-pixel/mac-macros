  SetFileInputCursor: function(isChooseButton, isOverTrigger) {
   ASPxStandardInputView.prototype.SetFileInputCursor.call(this, isChooseButton, isOverTrigger);
   var fileSelectorElement = this.GetFileSelectorElement();
