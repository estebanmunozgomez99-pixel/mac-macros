(function() {
var GridViewFixedGroupsHelper = ASPx.CreateClass(ASPx.TableHelperAdapter, {
 IndicatorClassName: "dxgvFGI",
 FixedRowClassName: "dxgvFGFixed",
 FloatingRowClassName: "dxgvFGFloating",
