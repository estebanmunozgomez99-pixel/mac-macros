  },
  GetLeftIndentLite: function () {
   var container = this.GetTabStripContainer();
   return container
    ? ASPx.GetNodesByPartialClassName(container, Constants.CssClassName.LEFT_INDENT)[0]
    : null;
  },
  GetRightIndentLite: function () {
   var container = this.GetTabStripContainer();
