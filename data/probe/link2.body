  iterateByReportRibbonItems: function(handlerArray) {
   if(!handlerArray) {
    return;
   }
   var handlers = [];
   for(var idx = 0; idx < handlerArray.length; idx++) {
    if(typeof(handlerArray[idx]) === "function") {
     handlers.push(handlerArray[idx])
