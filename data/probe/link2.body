  },
  Initialize: function () {
   if(this.GetVisibilityMode() == ElementVisibilityModeEnum.Faded)
    this.defaultOpacity = FadedDefaultOpacity;
  },
  GetOwner: function () {
   return this.itemsOwner;
  },
  GetContainer: function () {
   return this.GetOwner().GetButtonsContainer();
