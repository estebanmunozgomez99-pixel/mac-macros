    this.updateDragHandlePosition(this.getSecondaryDragHandleElement(), this.getInternalValue(1), withoutAnimation);
   }
   else
    this.updateDragHandlePosition(this.getMainDragHandleElement(), this.GetValue(), withoutAnimation);
