  IsModified: function() {
   return this.designerModel && this.designerModel.isDirty();
  },
  GetCurrentTab: function() {
   return this.designerModel && this.designerModel.navigateByReports.currentTab();
  },
  GetTabs: function() {
   return this.designerModel && this.designerModel.getTabs();
  },
  CloseTab: function(tab, force) {
   return this.designerModel && this.designerModel.closeTab(tab, force);
  },
  ResetIsModified: function() {
   if(this.designerModel) {
    this.designerModel.isDirty(false);
    this.designerModel.undoEngine && this.designerModel.undoEngine().clearHistory();
   }
  },
  AddToPropertyGrid: function(groupName, property) {
   var group = DevExpress.Reporting.Designer.Widgets.groups[groupName];
   if(group) {
    group.info.push(property);
   } else {
    DevExpress.Reporting.Designer.Widgets.groups[groupName] = { info: [property] }
   }
  },
  AddParameterType: function(parameterInfo, editorInfo) {
   DevExpress.Reporting.Designer.Data.Parameter.typeValues.push(parameterInfo);
   DevExpress.Analytics.Internal.editorTypeMapper[parameterInfo.value] = editorInfo;
  },
  RemoveParameterType: function(parameterType) {
   var position = DevExpress.Reporting.Designer.Data.Parameter.typeValues.indexOf(this.GetParameterInfo(parameterType));
   if(position !== -1) {
    DevExpress.Reporting.Designer.Data.Parameter.typeValues.splice(position, 1);
   }
  },
  GetParameterInfo: function(parameterType) {
   return DevExpress.Reporting.Designer.Data.Parameter.typeValues.filter(function(val) { return val.value === parameterType })[0];
  },
  GetParameterEditor: function(valueType) {
   return DevExpress.Analytics.Internal.editorTypeMapper[valueType];
  },
