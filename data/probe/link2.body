 if(edit)
  edit.OnTimeSectionClearClick();
};
ASPx.DETimeEditKeyDown = function(s,e) {
 var edit = ASPxClientDateEdit.active;
 if(!edit) return;
 switch(e.htmlEvent.keyCode) {
  case ASPx.Key.Enter:
   edit.OnTimeEditEnter();
   break;
  case ASPx.Key.Esc:
   edit.OnTimeEditEsc();
   break;
  case ASPx.Key.Tab:
   edit.OnTimeEditTab(e.htmlEvent.shiftKey);
   break;
 }
};
