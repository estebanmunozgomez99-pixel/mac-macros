    return this.GetItem(this.listTable.rows[i].itemIndex);
  return null;
 },
 GetLastRenderedItem: function () {
  for (var i = this.listTable.rows.length - 1; i >= 0; i--)
   if (this.listTable.rows[i].itemIndex !== undefined)
    return this.GetItem(this.listTable.rows[i].itemIndex);
