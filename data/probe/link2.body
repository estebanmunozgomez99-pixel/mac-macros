   ASPx.Attr.SetAttribute(dropZone.style, "top", anchorRect.top + "px");
   ASPx.Attr.SetAttribute(dropZone.style, "left", anchorRect.left + "px");
   ASPx.Attr.SetAttribute(dropZone.style, "padding", anchorStyle.padding);
