  onDropEventProcessed: function(files) {
   this.rawFiles = files;
   if(!this.options.enableMultiSelect && this.rawFiles.length > 1)
    this.raiseError(this.options.dragAndDropMoreThanOneFileError);
   else
    this.RaiseStateChangedInternal(this);
