  GetJsonReportModel: function() {
   var reportModel = this.designerModel.model().serialize();
   var result = null;
   if(this.reportModelRootName) {
    result = {};
    result[this.reportModelRootName] = reportModel;
   } else {
    result = reportModel;
   }
   return result;
