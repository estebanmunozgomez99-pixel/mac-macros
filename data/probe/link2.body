 ASPxClientReportDesigner.Cast = ASPxClientControl.Cast;
 ASPxClientReportDesigner.convertToCallbackString = function(obj) {
  var result = '';
  var isFirstIteration = true;
  for(var i in obj) {
   var value = obj[i];
   if(!value) {
    continue;
   }
   if(!isFirstIteration) {
    result += '&';
   }
   var jsonValue = typeof value === 'string' ? value : JSON.stringify(value);
   var encodedValue = encodeURIComponent(jsonValue);
   result += i + '=' + encodedValue;
   isFirstIteration = false;
  }
  return result;
 };
 ASPxClientReportDesigner.initAce = function(settings) {
  var ignoreAceLibsRedirectFromDX = settings && settings.ignoreAceLibsRedirectFromDX;
  var ace = window.ace;
  if(!ignoreAceLibsRedirectFromDX && ace) {
   var config = ace.config;
   config.setModuleUrl('ace/theme/dreamweaver', '/Nutrition/DXR.axd?r=24_415-lS3tn');
   config.setModuleUrl('ace/theme/ambiance', '/Nutrition/DXR.axd?r=24_414-lS3tn');
   config.setModuleUrl('ace/mode/json_worker', '/Nutrition/DXR.axd?r=24_411-lS3tn');
   config.setModuleUrl('ace/mode/csharp', '/Nutrition/DXR.axd?r=24_410-lS3tn');
   config.setModuleUrl('ace/mode/json', '/Nutrition/DXR.axd?r=24_413-lS3tn');
   config.setModuleUrl('ace/mode/vbscript', '/Nutrition/DXR.axd?r=24_412-lS3tn');
  }
 };
