   ASPxBaseView.prototype.refreshBase.call(this, args);
   ASPx.Data.ForEach(this.views, function(view) {
    this.refreshView(view, args);
   }.aspxBind(this));
  },
  Clear: function() {
   this.supressEvents = true;
   this.clearViews();
   this.supressEvents = false;
