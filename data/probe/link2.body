    progressControl;
   this.progressBarBaseId = templateProgressControl.name;
   clonedIndicatorDiv.id = this.progressBarBaseId + this.GetID() + "_DI";
   clonedBarMarkup.id = this.progressBarBaseId + this.GetID();
