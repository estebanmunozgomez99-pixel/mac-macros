   if (offset > 0)
    textWrapper.style.marginTop = Math.abs(offset) + "px";
   if (offset < 0)
    collapseButton.style.marginTop = Math.abs(offset) + "px";
   var computedStyle = ASPx.GetCurrentStyle(collapseButton);
