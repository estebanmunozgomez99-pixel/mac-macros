 var ASPxClientPreviewClickEventArgs = ASPx.CreateClass(ASPxClientEventArgs, {
  constructor: function(pageIndex, brick, defaultHandler) {
   this.constructor.prototype.constructor.call(this);
   this.PageIndex = pageIndex;
   this.Brick = brick;
   this.DefaultHandler = defaultHandler;
   this.GetBrickText = function() { return brick && brick.text(); };
   this.GetBrickValue = function(key) {
    key = key || "value";
    var contentValue = brick && brick.content && brick.content.filter(function(x) { return x.Key === key; })[0];
    return contentValue && contentValue.Value;
   };
   this.Handled = false;
  }
 });
 var ASPxClientCustomizeExportOptionsEventArgs = ASPx.CreateClass(ASPxClientEventArgs, {
  constructor: function (options) {
   this.constructor.prototype.constructor.call(this);
   this._e = new DevExpress.Reporting.CustomizeExportOptionsEventArgs(options);
   this.HideExportOptionsPanel = function() {
    return this._e.HideExportOptionsPanel.apply(this._e, arguments);
   }
   this.HideFormat = function () {
    return this._e.HideFormat.apply(this._e, arguments);
   }
   this.HideProperties = function () {
    return this._e.HideProperties.apply(this._e, arguments);
   }
   this.GetExportOptionsModel = function () {
    return this._e.GetExportOptionsModel.apply(this._e, arguments);
   }
  }
 });
 var ASPxClientCustomizeLocalizationEventArgs = ASPx.CreateClass(ASPxClientEventArgs, {
  constructor: function(callbacks) {
   this.constructor.prototype.constructor.call(this);
   this.LoadMessages = function(messages) {
    if(!messages) return;
    if(typeof messages.then === 'function') {
     callbacks.push(messages)
    } else {
     DevExpress.Analytics.Localization.loadMessages(messages);
    }
   }
  }
 });
