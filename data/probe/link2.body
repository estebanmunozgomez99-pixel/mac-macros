   }
   if(!handlers.length === 0) { return; }
   var tabCount = this.ribbonToolbar.GetTabCount();
   for(var tabIndex = 0; tabIndex < tabCount; tabIndex++) {
    var currentRibbonTab = this.ribbonToolbar.GetTab(tabIndex);
