  setCheckedState: function () {
   this.ribbon.updateClientStateField(getItemID(this, true), this.checked);
  }
 });
 var ASPxClientRibbonGalleryDropDownItem = ASPx.CreateClass(ASPxClientRibbonDropDownMenuItem, {
