 HeaderRowID: "DXHeadersRow",
 BatchChangesPreviewGroupRowID: "DXBatchChangesPreviewGroupRow",
 CommandButtonID: "DXCBtn",
 DataRowTemplateCellID: "tcrow",
 GroupFooterRowTemplateCellID: "tcgfr",
