  var recordKey = recordKeyInfo.key;
  var newItem = this.CreateNewItemElementCore(recordKey);
  this.AssignNewItemId(newItem, recordKey);
  this.PrepareNewRecordCommanButtonsIDList(newItem);
  return newItem;
 },
