ASPx.GridBatchEditFocusHelper = GridBatchEditFocusHelper;
ASPx.CardViewBatchEditFocusHelper = CardViewBatchEditFocusHelper;
ASPx.GridViewBatchEditChangesPreviewHelper = GridViewBatchEditChangesPreviewHelper;
