  var halfButtonHeight = 23, 
   currentY = 25;
  var diff = element.offsetHeight - currentY - halfButtonHeight;
  ASPx.SetStyles(this.getButtonContainer(), {
   transform: "translateY(" + (-diff) + "px)"
