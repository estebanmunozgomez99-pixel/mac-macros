    self.designerModel = designerModel;
    if(self.designerModel) {
     var setOnSave = function(model) {
      if(model)
       model.onSave = onSave;
     }
     setOnSave(self.designerModel.model());
     self.designerModel.model.subscribe(setOnSave);
