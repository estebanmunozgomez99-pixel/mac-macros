 var ASPxRibbonPopupMenuHelper = ASPx.CreateClass(ASPx.KbdHelper, {
  constructor: function(ribbon) {
   this.ribbon = ribbon;
  },
  getPopupMenu: function() {
   return ASPx.GetControlCollection().Get(this.ribbon.name + constants.POPUP_MENU_POSTFIX);
  },
  initializeEvents: function() {
   var popupMenu = this.getPopupMenu();
   if(!!popupMenu)
    ASPxClientRibbon.initializePopupMenuEvents(popupMenu);
  },
  populatePopupMenuWithItems: function(ribbonItem) {
   var popupMenu = this.getPopupMenu();
