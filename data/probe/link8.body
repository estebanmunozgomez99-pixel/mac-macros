    <script>


        function PostPartialView(url, container) {
            var allergens = $("#AllergenSelections").val();
            var tags = $("#TagSelections").val();

            $("#tdAllergens").text(allergens);
            if (allergens.length == 0) $("#tdAllergenLabel").hide(); else $("#tdAllergenLabel").show();
            if (tags.length == 0) $("#tdPreferenceLabel").hide(); else $("#tdPreferenceLabel").show();

            $("#tdPreferences").text(tags);

            var postdata = {"allergens" : allergens,"tags" : tags };            
            $.post(url, postdata).done(function (data) { $("#" + container).html(data); LoadingPanel.Hide(); }).fail(function () {LoadingPanel.Hide(); alert('fail ' + url); });
        }


    function MenuItemKeyPress(key,element, title, id, lineId) {
        var presskeys = (key.which) ? key.which : key.presskeys;
        if (presskeys == 13 || presskeys == 32) {
            MenuItemClick(element, title, id, lineId);
        }
    }



        function MenuItemClick(element, title, id, lineId) {
            var url = '/Nutrition/ServiceMenuReport/GetLabel' + '/' + id + "/" + lineId;
            PostPartialView(url, "divNutritionLabel");
            //popLabel.SetHeaderText(title);
            divPopupHeader.innerText = title;

            popLabel.ShowAtElement(element);
            popLabel.Focus();
        }
        function SelectedMenuDateItemChanged(e)
        {
            e.item.menu.SetSelectedItem(e.item.menu.GetRootItem());
        }

        function SelectedMenuItemChanged(e) {
            if (e.item.name != 'noaction') {
                tdMenuName.innerText = e.item.parent.GetText() + " " + e.item.GetText();
                $("#CurrentMenu").val(e.item.name);
                var url = '/Nutrition/ServiceMenuReport/GetReport' + '/' + e.item.name;
                LoadingPanel.Show();
                PostPartialView(url, "reportBody");
                //var dataToPost = $("#dataForm").serialize();
            }
        }

        function SelectedItemChanged(e) {
            if (e.item.name != 'noaction') {
                tdMenuName.innerText = e.item.group.GetText() + " " + e.item.GetText();
                $("#CurrentMenu").val(e.item.name);
                var url = '/Nutrition/ServiceMenuReport/GetReport' + '/' + e.item.name;
                LoadingPanel.Show();
                PostPartialView(url, "reportBody");
                
            }
        }

        function EndPost(data) {
            $("#reportBody").html(data);
        }
        /*********************************************************************************************************/
        function FilterResults() {
            var url = '/Nutrition/ServiceMenuReport/FilterReport' + '/' + $("#CurrentMenu").val();
            PostPartialView(url, "reportBody");


        }


        /*********************************************************************************************************/
        
        $(function () {
            var idx = 0;
            var firstItem = navUnits.GetGroup(idx).GetItem(0);
            if (firstItem) {
                firstItem.group.SetExpanded(true);
                navUnits.SetSelectedItem(firstItem);
                tdMenuName.innerText = firstItem.group.GetText() + " " + firstItem.GetText();
                var id = firstItem.name;
                $("#CurrentMenu").val(id);
                var url = '/Nutrition/ServiceMenuReport/GetReport' + '/' + id;
                PostPartialView(url, "reportBody");
            }
	    });	

    </script>




