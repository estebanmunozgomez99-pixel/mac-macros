    <script>
        function AllergensChanged(s, e) {
            var vals = s.GetSelectedValues().toString();
            if (vals.includes("None") == true)
            {
                s.UnselectAll();
                vals = "";
            }
            $("#AllergenSelections").val(vals);
            
        }
        function PreferencesChanged(s, e) {
            var vals = s.GetSelectedValues().toString();
            if (vals.includes("None") == true)
            {
                s.UnselectAll();
                vals = "";
            }
            $("#TagSelections").val(vals);
        }
        function ClearFilters() {
            chkTags.UnselectAll();
            chkAllergens.UnselectAll();
            $("#TagSelections").val("");
            $("#AllergenSelections").val("");
        }

    </script>


